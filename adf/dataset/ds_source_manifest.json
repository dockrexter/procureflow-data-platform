{
  "name": "ds_source_manifest",
  "properties": {
    "type": "Json",
    "parameters": {
      "path": {
        "type": "String",
        "defaultValue": ""
      },
      "file": {
        "type": "String",
        "defaultValue": ""
      },
      "account": {
        "type": "String",
        "defaultValue": ""
      }
    },
    "linkedServiceName": {
      "referenceName": "ls_source_blob",
      "type": "LinkedServiceReference",
      "parameters": {
        "account": {
          "value": "@dataset().account",
          "type": "Expression"
        }
      }
    },
    "typeProperties": {
      "location": {
        "type": "AzureBlobStorageLocation",
        "folderPath": {
          "value": "@dataset().path",
          "type": "Expression"
        },
        "fileName": {
          "value": "@dataset().file",
          "type": "Expression"
        },
        "container": "outbound"
      }
    }
  }
}
