{
	"name": "ds_source_csv",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_BlobStorage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"path": {
				"type": "string"
			},
			"file": {
				"type": "string"
			}
		},
		"folder": {
			"name": "sourceDatasets"
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@dataset().file",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().path",
					"type": "Expression"
				},
				"container": "outbound"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
