{
  "name": "ls_sftp",
  "properties": {
    "parameters": {
      "host": {
        "type": "String"
      },
      "user": {
        "type": "String"
      },
      "fingerprint": {
        "type": "String"
      },
      "vaultUrl": {
        "type": "String"
      },
      "secretName": {
        "type": "String"
      }
    },
    "type": "Sftp",
    "typeProperties": {
      "host": {
        "value": "@linkedService().host",
        "type": "Expression"
      },
      "port": 22,
      "skipHostKeyValidation": false,
      "hostKeyFingerprint": {
        "value": "@linkedService().fingerprint",
        "type": "Expression"
      },
      "authenticationType": "SshPublicKey",
      "userName": {
        "value": "@linkedService().user",
        "type": "Expression"
      },
      "privateKeyContent": {
        "type": "AzureKeyVaultSecret",
        "store": {
          "referenceName": "ls_keyvault",
          "type": "LinkedServiceReference",
          "parameters": {
            "vaultUrl": {
              "value": "@linkedService().vaultUrl",
              "type": "Expression"
            }
          }
        },
        "secretName": {
          "value": "@linkedService().secretName",
          "type": "Expression"
        }
      }
    }
  }
}
