{
  "name": "pl_blob_to_landing",
  "properties": {
    "description": "Copy fixed filenames from a flat source folder; archive by manifest business date. Do not overlap uploads and ingestion.",
    "concurrency": 1,
    "parameters": {
      "source": {
        "type": "String",
        "defaultValue": "SAP_S4HANA"
      },
      "sourceAccount": {
        "type": "String",
        "defaultValue": "pfsrcywlye2bmne5kc"
      },
      "account": {
        "type": "String",
        "defaultValue": "procureflowywlye2bmne5kc"
      },
      "tableFiles": {
        "type": "Array",
        "defaultValue": [
          "companies.csv",
          "exchange_rates.csv",
          "goods_receipts.csv",
          "invoice_headers.csv",
          "invoice_items.csv",
          "materials.csv",
          "payments.csv",
          "plants.csv",
          "po_headers.csv",
          "po_history.csv",
          "po_items.csv",
          "purchasing_organizations.csv",
          "suppliers.csv"
        ]
      }
    },
    "activities": [
      {
        "name": "CheckComplete",
        "type": "GetMetadata",
        "typeProperties": {
          "dataset": {
            "referenceName": "ds_source_blob",
            "type": "DatasetReference",
            "parameters": {
              "path": {
                "value": "@pipeline().parameters.source",
                "type": "Expression"
              },
              "file": "_SUCCESS",
              "account": {
                "value": "@pipeline().parameters.sourceAccount",
                "type": "Expression"
              }
            }
          },
          "fieldList": [
            "exists"
          ],
          "storeSettings": {
            "type": "AzureBlobStorageReadSettings",
            "recursive": false
          }
        }
      },
      {
        "name": "RequireComplete",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "CheckComplete",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@activity('CheckComplete').output.exists",
            "type": "Expression"
          },
          "ifTrueActivities": [],
          "ifFalseActivities": [
            {
              "name": "IncompleteBatch",
              "type": "Fail",
              "typeProperties": {
                "message": "Source has no completion marker; finish uploading first",
                "errorCode": "INCOMPLETE_BATCH"
              }
            }
          ]
        }
      },
      {
        "name": "ReadManifest",
        "type": "Lookup",
        "dependsOn": [
          {
            "activity": "RequireComplete",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "storeSettings": {
              "type": "AzureBlobStorageReadSettings",
              "recursive": false
            },
            "formatSettings": {
              "type": "JsonReadSettings"
            }
          },
          "dataset": {
            "referenceName": "ds_source_manifest",
            "type": "DatasetReference",
            "parameters": {
              "path": {
                "value": "@pipeline().parameters.source",
                "type": "Expression"
              },
              "file": "manifest.json",
              "account": {
                "value": "@pipeline().parameters.sourceAccount",
                "type": "Expression"
              }
            }
          },
          "firstRowOnly": true
        }
      },
      {
        "name": "ListSourceFiles",
        "type": "GetMetadata",
        "dependsOn": [
          {
            "activity": "ReadManifest",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "dataset": {
            "referenceName": "ds_source_folder",
            "type": "DatasetReference",
            "parameters": {
              "path": {
                "value": "@pipeline().parameters.source",
                "type": "Expression"
              },
              "account": {
                "value": "@pipeline().parameters.sourceAccount",
                "type": "Expression"
              }
            }
          },
          "fieldList": [
            "childItems"
          ],
          "storeSettings": {
            "type": "AzureBlobStorageReadSettings",
            "recursive": false
          }
        }
      },
      {
        "name": "ExpectedFilesPresent",
        "type": "Filter",
        "dependsOn": [
          {
            "activity": "ListSourceFiles",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('ListSourceFiles').output.childItems",
            "type": "Expression"
          },
          "condition": {
            "value": "@and(equals(item().type, 'File'), contains(pipeline().parameters.tableFiles, item().name))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "RequireExpectedFiles",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "ExpectedFilesPresent",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@and(and(equals(length(activity('ExpectedFilesPresent').output.value), length(pipeline().parameters.tableFiles)), equals(length(activity('ListSourceFiles').output.childItems), add(length(pipeline().parameters.tableFiles), 2))), equals(activity('ReadManifest').output.firstRow.source, pipeline().parameters.source))",
            "type": "Expression"
          },
          "ifTrueActivities": [],
          "ifFalseActivities": [
            {
              "name": "WrongFileSet",
              "type": "Fail",
              "typeProperties": {
                "message": "Missing/unexpected table files or wrong source in manifest",
                "errorCode": "SOURCE_CONTRACT_MISMATCH"
              }
            }
          ]
        }
      },
      {
        "name": "ClearLandingMarker",
        "type": "Delete",
        "dependsOn": [
          {
            "activity": "RequireExpectedFiles",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "dataset": {
            "referenceName": "ds_landing",
            "type": "DatasetReference",
            "parameters": {
              "path": {
                "value": "@concat(pipeline().parameters.source, '/', activity('ReadManifest').output.firstRow.batch_date)",
                "type": "Expression"
              },
              "file": "_SUCCESS",
              "account": {
                "value": "@pipeline().parameters.account",
                "type": "Expression"
              }
            }
          },
          "storeSettings": {
            "type": "AzureBlobFSReadSettings",
            "recursive": false
          },
          "enableLogging": false
        }
      },
      {
        "name": "CopyTables",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "ClearLandingMarker",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@pipeline().parameters.tableFiles",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "CopyTable",
              "type": "Copy",
              "policy": {
                "timeout": "0.00:20:00",
                "retry": 1,
                "retryIntervalInSeconds": 15
              },
              "inputs": [
                {
                  "referenceName": "ds_source_blob",
                  "type": "DatasetReference",
                  "parameters": {
                    "path": {
                      "value": "@pipeline().parameters.source",
                      "type": "Expression"
                    },
                    "file": {
                      "value": "@item()",
                      "type": "Expression"
                    },
                    "account": {
                      "value": "@pipeline().parameters.sourceAccount",
                      "type": "Expression"
                    }
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "ds_landing",
                  "type": "DatasetReference",
                  "parameters": {
                    "path": {
                      "value": "@concat(pipeline().parameters.source, '/', activity('ReadManifest').output.firstRow.batch_date)",
                      "type": "Expression"
                    },
                    "file": {
                      "value": "@item()",
                      "type": "Expression"
                    },
                    "account": {
                      "value": "@pipeline().parameters.account",
                      "type": "Expression"
                    }
                  }
                }
              ],
              "typeProperties": {
                "source": {
                  "type": "BinarySource",
                  "storeSettings": {
                    "type": "AzureBlobStorageReadSettings",
                    "recursive": false
                  }
                },
                "sink": {
                  "type": "BinarySink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings",
                    "copyBehavior": "PreserveHierarchy"
                  }
                },
                "enableStaging": false,
                "validateDataConsistency": true
              }
            }
          ]
        }
      },
      {
        "name": "CopyManifest",
        "type": "Copy",
        "policy": {
          "timeout": "0.00:20:00",
          "retry": 1,
          "retryIntervalInSeconds": 15
        },
        "inputs": [
          {
            "referenceName": "ds_source_blob",
            "type": "DatasetReference",
            "parameters": {
              "path": {
                "value": "@pipeline().parameters.source",
                "type": "Expression"
              },
              "file": "manifest.json",
              "account": {
                "value": "@pipeline().parameters.sourceAccount",
                "type": "Expression"
              }
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_landing",
            "type": "DatasetReference",
            "parameters": {
              "path": {
                "value": "@concat(pipeline().parameters.source, '/', activity('ReadManifest').output.firstRow.batch_date)",
                "type": "Expression"
              },
              "file": "manifest.json",
              "account": {
                "value": "@pipeline().parameters.account",
                "type": "Expression"
              }
            }
          }
        ],
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "AzureBlobStorageReadSettings",
              "recursive": false
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings",
              "copyBehavior": "PreserveHierarchy"
            }
          },
          "enableStaging": false,
          "validateDataConsistency": true
        },
        "dependsOn": [
          {
            "activity": "CopyTables",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "name": "CommitBatch",
        "type": "Copy",
        "policy": {
          "timeout": "0.00:20:00",
          "retry": 1,
          "retryIntervalInSeconds": 15
        },
        "inputs": [
          {
            "referenceName": "ds_source_blob",
            "type": "DatasetReference",
            "parameters": {
              "path": {
                "value": "@pipeline().parameters.source",
                "type": "Expression"
              },
              "file": "_SUCCESS",
              "account": {
                "value": "@pipeline().parameters.sourceAccount",
                "type": "Expression"
              }
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_landing",
            "type": "DatasetReference",
            "parameters": {
              "path": {
                "value": "@concat(pipeline().parameters.source, '/', activity('ReadManifest').output.firstRow.batch_date)",
                "type": "Expression"
              },
              "file": "_SUCCESS",
              "account": {
                "value": "@pipeline().parameters.account",
                "type": "Expression"
              }
            }
          }
        ],
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "AzureBlobStorageReadSettings",
              "recursive": false
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings",
              "copyBehavior": "PreserveHierarchy"
            }
          },
          "enableStaging": false,
          "validateDataConsistency": true
        },
        "dependsOn": [
          {
            "activity": "CopyManifest",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ]
  }
}
