{
	"name": "pl_source_to_landing",
	"properties": {
		"activities": [
			{
				"name": "RequireComplete",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@pipeline().parameters.CheckCompleteExists",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "IncompleteBatch",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Source has no completion marker; finish uploading first",
								"errorCode": "INCOMPLETE_BATCH"
							}
						}
					]
				}
			},
			{
				"name": "ListSourceFiles",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "RequireComplete",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_source_folder",
						"type": "DatasetReference",
						"parameters": {
							"path": {
								"value": "@pipeline().parameters.DataSourceName",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "ExpectedFilesPresent",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "ListSourceFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('ListSourceFiles').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(equals(item().type, 'File'), contains(pipeline().parameters.ExpectedFiles, item().name))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "RequireCompleteFiles",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "ExpectedFilesPresent",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(\n    greater(length(pipeline().parameters.ExpectedFiles), 0),\n    equals(\n        length(activity('ExpectedFilesPresent').output.value),\n        length(pipeline().parameters.ExpectedFiles)\n    )\n)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "WrongFileSet",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Missing/unexpected table files or wrong source in manifest",
								"errorCode": "SOURCE_CONTRACT_MISMATCH"
							}
						}
					]
				}
			},
			{
				"name": "Copy manifest",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "ForEachCsv",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_source_manifest",
						"type": "DatasetReference",
						"parameters": {
							"path": {
								"value": "@pipeline().parameters.DataSourceName",
								"type": "Expression"
							},
							"file": "manifest.json"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_landing_manifest",
						"type": "DatasetReference",
						"parameters": {
							"path": {
								"value": "@pipeline().parameters.DataSourceName",
								"type": "Expression"
							},
							"file": "manifest.json"
						}
					}
				]
			},
			{
				"name": "ForEachCsv",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "RequireCompleteFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('ExpectedFilesPresent').output.Value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy csv files",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "PreserveHierarchy"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".csv"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_source_csv",
									"type": "DatasetReference",
									"parameters": {
										"path": {
											"value": "@pipeline().parameters.DataSourceName",
											"type": "Expression"
										},
										"file": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_landing_csv",
									"type": "DatasetReference",
									"parameters": {
										"path": {
											"value": "@pipeline().parameters.DataSourceName",
											"type": "Expression"
										},
										"file": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"CheckCompleteExists": {
				"type": "bool"
			},
			"DataSourceName": {
				"type": "string"
			},
			"ExpectedFiles": {
				"type": "array"
			}
		},
		"annotations": []
	}
}