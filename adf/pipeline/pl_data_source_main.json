{
	"name": "pl_SAP_S4HANA",
	"properties": {
		"activities": [
			{
				"name": "CheckComplete",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_source_success",
						"type": "DatasetReference",
						"parameters": {
							"dataSource": {
								"value": "@pipeline().parameters.DataSourceName",
								"type": "Expression"
							},
							"fileName": "_SUCCESS"
						}
					},
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "pl_copy_source_to_landing",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Set variable1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_source_to_landing",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"CheckCompleteExists": {
							"value": "@activity('CheckComplete').output.exists",
							"type": "Expression"
						},
						"DataSourceName": {
							"value": "@pipeline().parameters.DataSourceName",
							"type": "Expression"
						},
						"ExpectedFiles": {
							"value": "@pipeline().parameters.ExpectedFiles",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Set variable1",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "CheckComplete",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "procureflow_inserted_timestamp",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "pl_copy_landing_to_bronze",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "pl_copy_source_to_landing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_landing_to_bronze",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"DataSourceName": {
							"value": "@pipeline().parameters.DataSourceName",
