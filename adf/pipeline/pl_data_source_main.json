						"ExpectedFiles": {
							"value": "@pipeline().parameters.ExpectedFiles",
							"type": "Expression"
						},
						"procureflow_inserted_timestamp": {
							"value": "@variables('procureflow_inserted_timestamp')",
							"type": "Expression"
						}
					}
				}
			}
		],
		"parameters": {
			"DataSourceName": {
				"type": "string",
				"defaultValue": "SAP_S4HANA"
			},
			"ExpectedFiles": {
				"type": "array",
				"defaultValue": [
					"companies.csv",
					"exchange_rates.csv",
					"goods_receipts.csv",
					"invoice_headers.csv",
					"invoice_items.csv",
					"materials.csv",
					"payments.csv",
					"plants.csv",
					"po_headers.csv",
					"po_history.csv",
					"po_items.csv",
					"purchasing_organizations.csv",
					"suppliers.csv"
				]
			}
		},
		"variables": {
			"procureflow_inserted_timestamp": {
				"type": "String"
			}
		},
		"annotations": []
	}
}