							"storeSettings": {
								"type": "AzureBlobStorageReadSettings",
								"recursive": false
							}
						}
					},
					{
						"name": "RequireComplete",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "CheckComplete",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@activity('CheckComplete').output.exists",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "IncompleteBatch",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": "Source has no completion marker; finish uploading first",
										"errorCode": "INCOMPLETE_BATCH"
									}
								}
							]
						}
					},
					{
						"name": "ReadManifest",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "RequireComplete",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "AzureBlobStorageReadSettings",
									"recursive": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"dataset": {
								"referenceName": "ds_source_manifest",
								"type": "DatasetReference",
								"parameters": {
									"path": {
										"value": "@pipeline().parameters.source",
										"type": "Expression"
									},
									"file": "manifest.json",
									"account": {
										"value": "@pipeline().parameters.sourceAccount",
										"type": "Expression"
									}
								}
							},
							"firstRowOnly": true
						}
					},
					{
						"name": "ListSourceFiles",
						"type": "GetMetadata",
						"dependsOn": [
							{
								"activity": "ReadManifest",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "ds_source_folder",
								"type": "DatasetReference",
								"parameters": {
									"path": {
										"value": "@pipeline().parameters.source",
										"type": "Expression"
									},
									"account": {
										"value": "@pipeline().parameters.sourceAccount",
										"type": "Expression"
									}
								}
							},
							"fieldList": [
								"childItems"
							],
							"storeSettings": {
								"type": "AzureBlobStorageReadSettings",
								"recursive": false
							}
						}
					},
					{
						"name": "ExpectedFilesPresent",
						"type": "Filter",
						"dependsOn": [
							{
								"activity": "ListSourceFiles",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('ListSourceFiles').output.childItems",
								"type": "Expression"
							},
							"condition": {
								"value": "@and(equals(item().type, 'File'), contains(pipeline().parameters.tableFiles, item().name))",
								"type": "Expression"
							}
						}
					},
					{
						"name": "RequireExpectedFiles",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "ExpectedFilesPresent",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@and(and(equals(length(activity('ExpectedFilesPresent').output.value), length(pipeline().parameters.tableFiles)), equals(length(activity('ListSourceFiles').output.childItems), add(length(pipeline().parameters.tableFiles), 2))), equals(activity('ReadManifest').output.firstRow.source, pipeline().parameters.source))",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "WrongFileSet",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
