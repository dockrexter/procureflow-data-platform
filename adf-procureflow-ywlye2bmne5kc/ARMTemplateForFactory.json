											"type": "BinarySource",
											"storeSettings": {
												"type": "AzureBlobStorageReadSettings",
												"recursive": false
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings",
												"copyBehavior": "PreserveHierarchy"
											}
										},
										"enableStaging": false,
										"skipErrorFile": {
											"dataInconsistency": false
										},
										"validateDataConsistency": true
									},
									"inputs": [
										{
											"referenceName": "ds_source_blob",
											"type": "DatasetReference",
											"parameters": {
												"path": {
													"value": "@pipeline().parameters.source",
													"type": "Expression"
												},
												"file": {
													"value": "@item()",
													"type": "Expression"
												},
												"account": {
													"value": "@pipeline().parameters.sourceAccount",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_landing",
											"type": "DatasetReference",
											"parameters": {
												"path": {
													"value": "@concat(pipeline().parameters.source, '/', activity('ReadManifest').output.firstRow.batch_date)",
													"type": "Expression"
												},
												"file": {
													"value": "@item()",
													"type": "Expression"
												},
												"account": {
													"value": "@pipeline().parameters.account",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					},
					{
						"name": "CopyManifest",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "CopyTables",
								"dependencyConditions": [
