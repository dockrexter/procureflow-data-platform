			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Copy fixed filenames from a flat source folder; archive by manifest business date. Do not overlap uploads and ingestion.",
				"activities": [
					{
						"name": "CheckComplete",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "ds_source_blob",
								"type": "DatasetReference",
								"parameters": {
									"path": {
										"value": "@pipeline().parameters.source",
										"type": "Expression"
									},
									"file": "_SUCCESS",
									"account": {
										"value": "@pipeline().parameters.sourceAccount",
										"type": "Expression"
									}
								}
							},
							"fieldList": [
								"exists"
